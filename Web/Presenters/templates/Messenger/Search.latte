{extends "../@layout.latte"}
{block title}{_messenger_search_title}{if $query !== ""} — {$query}{/if}{/block}

{block header}
    <a href="/im">{_my_messages}</a> » {_messenger_search_title}
{/block}

{block content}
    {include "searchbar.latte", query => $query, open => true}

    <div class="im-search-live">
        {include "searchresults.latte"}
    </div>
{/block}
